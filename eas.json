{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "YOUR_APPLE_ID@example.com",        // REPLACE: Your Apple ID email
        "ascAppId": "YOUR_ASC_APP_ID",                // REPLACE: App Store Connect App ID
        "appleTeamId": "YOUR_TEAM_ID"                 // REPLACE: Apple Developer Team ID
      },
      "android": {
        "serviceAccountKeyPath": "./fastlane/google-play-credentials.json", // REPLACE: Path to service account JSON
        "track": "production"
      }
    },
    "beta": {
      "ios": {
        "appleId": "YOUR_APPLE_ID@example.com",        // REPLACE: Your Apple ID email
        "ascAppId": "YOUR_ASC_APP_ID",                // REPLACE: App Store Connect App ID
        "appleTeamId": "YOUR_TEAM_ID"                 // REPLACE: Apple Developer Team ID
      },
      "android": {
        "serviceAccountKeyPath": "./fastlane/google-play-credentials.json", // REPLACE: Path to service account JSON
        "track": "internal"
      }
    }
  }
}
