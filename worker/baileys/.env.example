# Baileys Gateway Configuration
# Copie para .env e preencha os valores

# URL do Worker Leviã (onde está /api/wa/inbound)
WORKER_URL=https://levia-ia-worker.ferpa2505.workers.dev

# Segredo HMAC para assinatura do webhook (gere com: openssl rand -hex 32)
# Deve ser igual ao WHATSAPP_WEBHOOK_SECRET configurado no Worker
WHATSAPP_WEBHOOK_SECRET=

# Intervalo do heartbeat em ms (default: 30000 = 30s)
HEARTBEAT_INTERVAL_MS=30000

# Delay de reconexão em ms (default: 5000 = 5s)
RECONNECT_DELAY_MS=5000

# Nome da sessão (para logs)
SESSION_NAME=levia-gateway