{
  "expo": {
    "name": "Leviã",
    "slug": "levia-app",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.ferpa2505art.levia"
    },
    "android": {
      "package": "com.ferpa2505art.levia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6FA58E"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#6FA58E"
        }
      ]
    ],
    "scheme": "levia",
    "extra": {
      "eas": {
        "projectId": "c19a5f1e-5fbd-4100-ad78-43b05b47a977"
      }
    },
    "owner": "ferpa2505-art",
    "updates": {
